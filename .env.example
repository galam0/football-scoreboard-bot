# 디스코드 개발자 포털 → Bot → Token
DISCORD_TOKEN=

# https://dashboard.api-football.com 에서 발급한 키 (api-sports.io 직접 가입용)
API_FOOTBALL_KEY=

# (선택) 테스트 서버 ID. 넣으면 슬래시 명령어가 바로 반영돼요. 비우면 전체 서버에 등록(반영까지 최대 1시간)
GUILD_ID=

# (선택) 선수 사진 표시. 기본은 0(번호 원만 표시), 1이면 사진을 넣어요
SHOW_PHOTOS=0

# (선택) 이름 옆 국기(국적) 표시. 0이면 끔
SHOW_FLAGS=1

# (선택) 0이면 /스코어보드를 쓸 때만 갱신(기본), 1이면 경기가 끝날 때까지 같은 메시지를 자동 갱신
AUTO_UPDATE=0

# (선택) AUTO_UPDATE=1일 때 경기 중 갱신 주기(초). 유료 플랜이면 30~60도 가능
POLL_SECONDS=90

# 데이터 소스: espn(기본, 키 불필요·선수 사진 없음) 또는 api-football(키 필요)
DATA_SOURCE=espn
